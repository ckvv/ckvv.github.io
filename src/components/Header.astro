---
import Github from '@/assets/github.svg';
import { NAVS, REPOSITORY, SITE_TITLE } from '@/consts';
import Link from './Link.astro';
---

<header class="sticky top-0 px-4 bg-white z-50 shadow-md">
	<nav class="w-full max-w-6xl m-auto elect-none flex justify-between items-center text-2xl my-3 md:my-4" aria-label="Main navigation">
		<div class="flex gap-2 md:gap-4 items-center font-bold">
			<h2><a href="/">{SITE_TITLE}</a></h2>
		</div>
		<button
  data-astro-button-menu
  class="md:hidden select-none cursor-pointer text-3xl leading-none"
  aria-expanded="false"
  aria-controls="mobile-menu"
  aria-label="Toggle menu"
		>
			☰
		</button>
		<div
  id="mobile-menu"
  class="z-20 flex gap-2 md:gap-4 flex-col md:flex-row max-md:absolute max-md:bg-white max-md:left-0 max-md:right-0 max-md:top-14 max-md:gap-4 max-md:py-6 max-md:shadow max-md:border-t max-md:border-gray-300 max-md:hidden"
		>
			{
				NAVS.map(v => (
					<Link href={v.href} class="px-1 justify-center">
						{v.label}
					</Link>
				))
			}
			<a href={REPOSITORY} target="_blank" aria-label="GitHub repository">
				<Github class="m-auto" />
			</a>
		</div>
	</nav>
</header>

<script>
const menuButton = document.querySelector('[data-astro-button-menu]') as HTMLButtonElement;
const menu = document.getElementById('mobile-menu') as HTMLElement;

menuButton?.addEventListener('click', () => {
  const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
  menuButton.setAttribute('aria-expanded', `${!isOpen}`);
  menuButton.textContent = isOpen ? '☰' : '✕';
  menu.classList.toggle('max-md:hidden', isOpen);
});
</script>
