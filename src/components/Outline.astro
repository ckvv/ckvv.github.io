---
import type { MarkdownHeading } from 'astro';

type Props = {
  headings: MarkdownHeading[];
};

const { headings } = Astro.props;
---

{
  headings?.length
? (
  <div class="sticky z-10 top-20 inline-block text-left w-full">
    <div class="2xl:hidden flex justify-end">
      <button type="button" class="shadow-md inline-flex justify-center gap-x-1.5 rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 hover:bg-gray-50" id="menu-button" aria-expanded="false" aria-controls="md-outline-content" aria-haspopup="true">
        On this page
        <svg class="-mr-1 size-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon">
          <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
        </svg>
      </button>
    </div>

    <nav id="md-outline-content" class="hidden max-h-[calc(100vh-200px)] overflow-auto absolute right-0 py-2 mt-2 min-w-48 max-w-full origin-top-right rounded-md bg-white ring-1 shadow-lg ring-black/5 focus:outline-hidden 2xl:-right-12 2xl:float-right 2xl:translate-x-full 2xl:max-w-[min(calc(50vw-580px),320px)]" aria-label="Table of contents">
      { headings.map((v) => {
        return <a class="outline-item block px-4 py-1 text-sm break-all" href={`#${v.slug}`}>{ v.text }</a>;
      })}
    </nav>
  </div>
  )
: null
}

<style>
.outline-item-active {
  color: var(--color-sky-700);
}
</style>

<script>
function throttle(func: (entries: IntersectionObserverEntry[]) => void, limit: number) {
  let lastFunc: ReturnType<typeof setTimeout>;
  let lastRan: number;
  return (...args: [IntersectionObserverEntry[]]) => {
    if (!lastRan) {
      func(...args);
      lastRan = Date.now();
    } else {
      clearTimeout(lastFunc);
      lastFunc = setTimeout(() => {
        if (Date.now() - lastRan >= limit) {
          func(...args);
          lastRan = Date.now();
        }
      }, limit - (Date.now() - lastRan));
    }
  };
}

function init() {
  const menuButton = document.getElementById('menu-button') as HTMLButtonElement;
  const menu = document.getElementById('md-outline-content') as HTMLElement;
  if (!menuButton || !menu) {
    return;
  }

  function toggleMenu(force?: boolean) {
    const isOpen = force !== undefined ? force : menuButton.getAttribute('aria-expanded') === 'true';
    menuButton.setAttribute('aria-expanded', `${!isOpen}`);
    menu.classList.toggle('hidden', isOpen);
  }

  function onResize() {
    const is2xl = window.innerWidth >= 1536;
    if (is2xl) {
      menu.classList.remove('hidden');
      menuButton.setAttribute('aria-expanded', 'true');
    } else {
      menu.classList.add('hidden');
      menuButton.setAttribute('aria-expanded', 'false');
    }
  }

  window.addEventListener('resize', onResize);
  onResize();

  menu.addEventListener('click', (e: Event) => {
    const target = e.target as HTMLElement;
    if (target.tagName === 'A') {
      e.preventDefault();
      const section = document.querySelector(target.getAttribute('href')!);
      if (section) {
        window.scrollTo({ top: section.getBoundingClientRect().top + window.scrollY - 64, behavior: 'smooth' });
      }
    }
  });

  menuButton.addEventListener('click', () => toggleMenu());

  document.addEventListener('click', (event: MouseEvent) => {
    if (window.innerWidth >= 1536) {
      return;
    }
    const target = event.target as HTMLElement;
    if (target.id !== 'menu-button' && !menu.contains(target) && menuButton.getAttribute('aria-expanded') === 'true') {
      toggleMenu(true);
    }
  });

  const sections = document.querySelector('.content')?.querySelectorAll('h1, h2, h3');
  const navLinks = document.querySelectorAll('.outline-item');
  if (!sections || !navLinks.length) {
    return;
  }

  const observer = new IntersectionObserver(
    throttle((entries: IntersectionObserverEntry[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          navLinks.forEach((link) => {
            const activeHash = `#${id}`;
            link.classList.remove('outline-item-active');
            if (link.getAttribute('href') === activeHash) {
              link.classList.add('outline-item-active');
              history.replaceState(null, '', activeHash);
            }
          });
        }
      });
    }, 200),
    { root: null, rootMargin: '0px', threshold: 0.6 },
  );

  sections.forEach(section => observer.observe(section));
}

document.addEventListener('DOMContentLoaded', init);
</script>

