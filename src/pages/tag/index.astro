---
import Tag from '@/components/Tag.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPosts, groupPostsByTag } from '@/utils';

const groups = groupPostsByTag(await getPosts());
---
<BaseLayout>
	<div class="text-lg tags flex flex-wrap gap-4 justify-center py-8 md:my-24 select-none">
		{
			Array.from(groups, ([tag, posts]) => (
				<Tag href={`/tag/${tag}/`}>
					{tag}<sup class="pl-1">{posts.length}</sup>
				</Tag>
			))
		}
	</div>
</BaseLayout>
